{
  "name": "@workspace/desktop-app",
  "version": "1.0.7",
  "description": "CBT Software Local — Electron desktop wrapper",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.cbtsoftware.local",
    "productName": "CBT Software Local",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../artifacts/api-server/dist-local",
        "to": "server",
        "filter": [
          "**/*",
          "!cbt-local.db",
          "!cbt-local.db-shm",
          "!cbt-local.db-wal"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "deleteAppDataOnUninstall": false,
      "createStartMenuShortcut": true,
      "shortcutName": "CBT Software Local"
    },
    "asar": true,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "adeluav3-ui",
      "repo": "cbtsoftware-releases",
      "private": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
