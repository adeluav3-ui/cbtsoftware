{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@workspace/db": [
        "../../lib/db/src"
      ],
      "@workspace/db/*": [
        "../../lib/db/src/*"
      ],
      "@workspace/api-zod": [
        "../../lib/api-zod/src"
      ],
      "@workspace/api-zod/*": [
        "../../lib/api-zod/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}