{
    "buildCommand": "pnpm run build",
    "installCommand": "cd ../.. && pnpm install",
    "outputDirectory": "dist/public",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ],
    "env": {
        "VITE_API_URL": "https://cbtsoftware.onrender.com/api"
    }
}