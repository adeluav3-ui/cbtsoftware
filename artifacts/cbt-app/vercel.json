{
    "buildCommand": "pnpm run build",
    "installCommand": "cd ../.. && pnpm install",
    "outputDirectory": "dist/public",
    "framework": "vite",
    "routes": [
        {
            "src": "/assets/(.*)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            },
            "dest": "/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}